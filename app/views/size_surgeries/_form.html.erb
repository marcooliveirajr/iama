<%= form_for(@size_surgery, html: { class: "ls-form row" }) do |f| %>
  <fieldset>

    <div class="row">
      <div class="col-md-8">
        <label class="ls-label col-md-8 <%= class_error @size_surgery, :health_insurance_id %>">
        <span class="ls-label-text"><%= f.label :health_insurance_id, "Convênio Médico:" %></span>
          <div class="ls-custom-select">
            <%= f.collection_select(:health_insurance_id, HealthInsurance.all, :id, :name, class: "ls-state ls-select", prompt: true) %>
          </div>
          <%= show_message_error @size_surgery, :health_insurance_id %>
        </label>
      </div>
    </div>

    <div class="row">
      <div class="col-md-8">
        <label class="ls-label col-md-8 <%= class_error @size_surgery, :measure %>">
        <span class="ls-label-text"><%= f.label :measure, "Porte:" %></span>
        <%= f.text_field :measure %>
        <%= show_message_error @size_surgery, :measure %>
      </label>
     </div>
    </div>

    <div class="row">
      <div class="col-md-8">
        <label class="ls-label col-md-8">
        <span class="ls-label-text"><%= f.label :value_measure, "Valor:" %></span>
        <%= f.text_field :value_measure, value: fmt_moeda_form(@size_surgery.value_measure), class: 'ls-mask-money' %>
      </label>
     </div>
    </div>

 </fieldset>

  <div class="ls-actions-btn">
      <%= f.button  "Salvar", :type => "submit" , class: "ls-btn-primary"%>
      <%= link_to 'Voltar', size_surgeries_path, class: "ls-btn-darker" %>
  </div>

<% end %>


