<%= form_for(@size_surgery, html: { class: "ls-form row" }) do |f| %>
  <% if @size_surgery.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(@size_surgery.errors.count, "error") %> prohibited this size_surgery from being saved:</h2>

      <ul>
      <% @size_surgery.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>
  
  <fieldset>

    <div class="row">
      <div class="col-md-8">
        <label class="ls-label col-md-4">
        <span class="ls-label-text"><%= f.label :health_insurance_id, "Convênio Médico" %></span>
          <div class="ls-custom-select">
            <%= f.collection_select(:health_insurance_id, HealthInsurance.all, :id, :name, class: "ls-state ls-select") %>
          </div>
        </label>
      </div>
    </div>  

    <div class="row">
      <div class="col-md-8">
        <label class="ls-label col-md-8">
        <span class="ls-label-text"><%= f.label :size, "Porte" %></span>
        <%= f.text_field :size %>
      </label>
     </div>
    </div>

    <div class="row">
      <div class="col-md-8">
        <label class="ls-label col-md-8">
        <span class="ls-label-text"><%= f.label :value, "Valor" %></span>
        <%= f.text_field :value %>
      </label>
     </div>
    </div>

 </fieldset>

  <div class="ls-actions-btn">
      <%= f.button  "Salvar", :type => "submit" , class: "ls-btn-primary"%>
      <%= link_to 'Voltar', size_surgeries_path, class: "ls-btn-darker" %>
  </div>

<% end %>


