<h1 class="ls-title-intro ls-ico-text">Portes de Cirurgia</h1>
<%= flash_messages %>
<div class="ls-box">
  <div class="row">
    <div class="col-md-12">
        <table class="ls-table ls-table-striped ls-no-hover ls-sm-space ls-no-margin-top">
          <tbody>
            <tr> 
              <td> Convênio Médico: 
                <label class="ls-title-6"><%= @size_surgery.health_insurance.name %>
                </label> 
              </td> 
            </tr>
            <tr> 
              <td> Porte: 
                <label class="ls-title-6"><%= @size_surgery.measure %>
                </label> 
              </td> 
            </tr>
            <tr> 
              <td> Valor: 
                <label class="ls-title-6"><%= @size_surgery.value_measure %>
                </label> 
              </td> 
            </tr>
          </tbody>
        </table>
    </div>
  </div>
</div>

<%= link_to 'Editar', edit_size_surgery_path(@size_surgery) , class: "ls-btn-darker" %>
<%= link_to 'Voltar', size_surgeries_path, class: "ls-btn-darker" %>
<a><%= link_to 'Cadastrar Porte', new_size_surgery_path(@bedroom) , class: "ls-btn-primary" %></a>