<h1 class="ls-title-intro ls-ico-text">Portes de Cirurgia</h1>
<%= form_for(@size_surgery, html: { class: "ls-form row" }) do |f| %>
<div class="ls-box">
<div class="row">
  <div class="col-md-12">
    <div class="ls-box">
      <p><strong>Convênio Médico</strong></p>
      <p class="ls-break-text"><%= @size_surgery.health_insurance.name %></p>
      <hr>
      <p><strong>Porte</strong></p>
      <p class="ls-break-text"><%= @size_surgery.size %></p>
      <hr>
      <p><strong>Valor</strong></p>
      <p class="ls-break-text"><%= @size_surgery.value %></p>
    </div>
  </div>
</div>
</div>

<%= link_to 'Editar', edit_size_surgery_path(@size_surgery) , class: "ls-btn-darker" %>
<%= link_to 'Voltar', size_surgeries_path, class: "ls-btn-darker" %>

<% end %>

