<h1 class="ls-title-intro ls-ico-text">Mapa</h1>
<%= flash_messages %>
<a><%= link_to 'Cadastrar Mapa', new_map_path(@map) , class: "ls-btn-primary" %></a>

<div class="ls-box-filter">
  <%= form_for :search, url: search_maps_path, html: { :class => "ls-form ls-form-inline", method: :get } do |f| %>
  <label class="ls-label col-md-4">
    <b class="ls-label-text">Buscar por:</b>
    <div class="ls-custom-select">

      <%= f.select(:type, {prompt: false}, class: "ls-select") do %>
      <% [['Anestesista', 'anesthetists.name'],['Hospital', 'hospital.name'], ['Paciente', 'patient.name']].each do |c| %>
      <%= content_tag(:option, c.first, value: c.last) %>
      <% end %>
      <% end %>

    </div>
  </label>

  <label class="ls-label col-md-4" role="search" id="text_order_search">
    <%= f.text_field :text, class: 'ls-field' %>
  </label>

  <label class="ls-label ">
    <%= submit_tag('Buscar', class: "ls-btn") %>
  </label>
  <%= hidden_field_tag :per_page, params[:per_page] %>
  <%end%>
</div>

<tbody>
  <% @maps.each do |map| %>

  <div class="ls-list">
    <header class="ls-list-header">
      <div class="ls-list-title col-md-9">
        <strong><%= link_to map.health_terminology.description_tuss, map %></strong>
        <small><%= map.time_surgery %></small>
      </div>
      <div class="col-md-3 ls-txt-right">
        <div data-ls-module="dropdown" class="ls-dropdown ls-pos-right">
          <a href="#" class="ls-btn-primary">Administrar</a>
          <ul class="ls-dropdown-nav">
            <li><%= link_to 'Editar', edit_map_path(map) %></li>
            <li><%= link_to 'Visualizar', map %></li>
            <li><%= link_to 'Excluir', map_path(map), data: { confirm: "Você tem certeza?" }, method: :delete, class: "ls-color-danger ls-divider" %></li>
          </ul>
        </div>
      </div>
    </header>
    <div class="ls-list-content ">
      <div class="col-sm-3">
        <span class="ls-list-label">Hospital</span>
        <strong><%= map.hospital.name %></strong>
      </div>
      <div class="col-sm-3">
        <span class="ls-list-label">Quarto</span>
        <strong><%= map.bedroom.name %></strong>
      </div>

      <div class="col-sm-3">
        <span class="ls-list-label">Paciente</span>
        <strong><%= map.patient.name %></strong>
      </div>
      <div class="col-sm-3">
        <span class="ls-list-label">Cirurgião</span>
        <strong><%= map.surgeon.name %></strong>
      </div>
    </div>

    <div class="ls-list-content ">
      <div class="col-sm-3">
        <span class="ls-list-label">Anestesista</span>
        <strong><%= map.anesthetist.name %></strong>
      </div>
      <div class="col-sm-3">
        <span class="ls-list-label">Convênio</span>
        <strong><%= map.health_insurance.name %></strong>
      </div>

      <div class="col-sm-3">
        <span class="ls-list-label">Data do pagamento</span>
        <strong><%= map.payment_date %></strong>
      </div>
      <div class="col-sm-3">
        <span class="ls-list-label">Valor</span>
        <strong><%= map.value %></strong>
      </div>
    </div>
  </div>
  <% end %>

</tbody>

<% if @maps %>
<div class="ls-pagination-filter">
  <%= paginate @maps if @maps %>

  <% if not @maps.blank? %>
  <div class="ls-filter-view">
    <%= t 'will_paginate.show' %>
    <div class="ls-custom-select">
      <%= select_tag(:per_page_options, options_for_select(options_for_per_page, params[:per_page]))%>
    </div>
    <%= t 'will_paginate.per_page' %>
  </div>
  <% end %>
</div>
<% end %>
