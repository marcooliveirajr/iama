<h1 class="ls-title-intro ls-ico-text">Mapa</h1>

<a><%= link_to 'Cadastrar Mapa', new_map_path(@map) , class: "ls-btn-primary" %></a>

<div class="ls-box-filter">
  <form method="get" accept-charset="UTF-8" action="/maps/search" id="new_customer_search" class="ls-form ls-form-inline" novalidate="novalidate"><input type="hidden" value="✓" name="utf8">
    <label class="ls-label col-md-4">
      <b class="ls-label-text">Buscar por:</b>
      <div class="ls-custom-select">
        <select name="" class="ls-select">
          <option>Hospital</option>
          <option>Paciente</option>
          <option>Cirurgião</option>
          <option>Anestesista</option>
          <option>Procedimento</option>
        </select>
      </div>
    </label>

    <label role="search" class="ls-label col-md-4">
      <div>
        <input type="text" class="ls-field">
      </div>
    </label>
    <label class="ls-label ">
      <input type="submit" class="ls-btn" value="Buscar" name="commit" aria-expanded="false" role="combobox">
    </label>
  </form>
</div>

<table class="ls-table ls-table-striped">
  <thead>
    <tr>
    <tr>
      <th>Data/Hora</th>
      <th>Hospital</th>
      <th>Quarto</th>
      <th>Paciente</th>
      <th>Procedimento</th>
      <th>Cirurgião</th>
      <th>Anestesista</th>
      <th>Convênio Médico</th>
      <th class="hidden-xs">Observação</th>
    </tr>
  </thead>

  <tbody>
    <% @maps.each do |map| %>
    <tr>
      <td><%= link_to map.time_surgery, map %></td>
      <td><%= map.hospital.name %></td>
      <td><%= map.bedroom.name %></td>
      <td><%= map.patient.name %></td>
      <td><%= map.health_terminology.description_tuss %></td>
      <td><%= map.surgeon.name %></td>
      <td><%= map.anesthetist.name %></td>
      <td><%= map.health_insurance.name %></td>
      <td class="hidden-xs"><%= map.note %></td>
    </tr>
    <% end %>
  </tbody>
</table>

<% if @maps %>
<div class="ls-pagination-filter">
  <%= paginate @maps if @maps %>

  <% if not @maps.blank? %>
  <div class="ls-filter-view">
    <%= t 'helpers.show' %>
    <div class="ls-custom-select">
      <%= select_tag(:per_page_options, options_for_select(options_for_per_page, params[:per_page]))%>
    </div>
    <%= t 'helpers.per_page' %>
  </div>
  <% end %>
</div>
<% end %>