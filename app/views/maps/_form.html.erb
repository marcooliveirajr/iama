      </div>
  
      <div class="row">
        <div class="col-md-10">
          <label class="ls-label col-md-10">
            <span class="ls-label-text">Código TUSS: </span>
            <small class="tuss4 ls-label-text"></small>
          </label>
          <label class="ls-label col-md-10">
            <span class="ls-label-text">Porte: </span>
            <small class="measure4 ls-label-text"></small>
          </label>
        </div>
      </div>
  
      <div class="row">
        <div class="col-md-8">
          <label class="ls-label col-md-4">
          <b class="ls-label-text"><%= f.label :via_unique4, "Via Única:" %></b>
          <div class="ls-custom-select">
              <%= f.select :via_unique4, [['Nenhum', nil], ['Sim', true], ['Não', false]] %>
          </div>
          </label>
        </div>
      </div>
  
      <div class="row">
        <div class="col-md-10">
          <label class="ls-label col-md-10">
