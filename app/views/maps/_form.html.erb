            <div class="ls-custom-select">
              <%= f.collection_select(:receipt_id, Receipt.all, :id, :name, class: 'ls-select', prompt: true) %>
            </div>
          </label>
        </div>
      </div>
    
      <div class="row">
        <div class="col-md-8">
          <label class="ls-label col-md-6">
            <span class="ls-label-text"><%= f.label :receipt_day, "Data de emissão do recibo:" %></span>
            <div class='input-group date' id='receipt_day'>
              <%= f.text_field :receipt_day, value: @map.try(:receipt_day).try(:strftime, "%d/%m/%Y") , class: 'form-control'%>
