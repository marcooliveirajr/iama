        <div class="col-md-10">
          <label class="ls-label col-md-10">
            <span class="ls-label-text"><%= label :anesthetist, "Anestesista:" %></span>
            <div> 
              <%= f.collection_select(:anesthetist_id, Anesthetist.all, :id, :name, prompt: true) %>
            </div>
          </label>
        </div>
      </div>
      
