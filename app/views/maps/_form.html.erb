          <div class="ls-custom-select">
              <%= f.select :via_unique2, [['Nenhum', nil], ['Sim', true], ['Não', false]] %>
          </div>
          </label>
        </div>
      </div>
  
      <div class="row">
        <div class="col-md-10">
          <label class="ls-label col-md-10">
            <span class="ls-label-text"><%= f.label :tuss3_id, "Procedimento 3 - TUSS:" %></span>
