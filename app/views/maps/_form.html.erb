        </div>
      </div>

    </div>
  
    <div id="contact" class="ls-tab-content">

      <div class="row">
        <div class="col-md-10">
          <label class="ls-label col-md-10">
            <span class="ls-label-text"><%= f.label :payment_method_id, "Método de Pagamento:" %></span>
            <div class="ls-custom-select">
              <%= f.collection_select(:payment_method_id, PaymentMethod.all, :id, :name, class: 'ls-select', prompt: true) %>
            </div>
          </label>
        </div>
      </div>

      <div class="row">
        <div class="col-md-8">
          <label class="ls-label col-md-8">
            <span class="ls-label-text"><%= f.label :payment, "Valor Cobrado:" %></span>
            <div class="row">
              <div class="ls-prefix-group col-md-8">
                <input type='text' id='value' />
                <a href="#" id='add-Payment' class="ls-label-text-prefix ls-bg-white">+</a>
              </div>
            </div>
          </label>
        </div>
      </div>
      
      <div class='col-md-10'>
        <table id='payments', class='ls-table'>
          <thead>
            <th>Parcela</th>
            <th>Data Cobrança</th>
            <th>Data Pagto</th>
            <th>Valor Cobrado</th>
            <th>Valor Pago</th>
            <th>Beneficiário</th>
          </thead>
          <tbody>
            <% @map.payment_maps.each do |payment_map| %>
            <tr>
              <td><%= text_field_tag "map[payment_maps][#{payment_map.id}][payment_id]", payment_map.payment_id, class: 'col-md-10' %></td>
              <td><%= text_field_tag "map[payment_maps][#{payment_map.id}][payment_date]", payment_map.payment_date.try(:strftime, "%d/%m/%Y"), class: 'col-md-10' %></td>
              <td><%= text_field_tag "map[payment_maps][#{payment_map.id}][pay_day]", payment_map.pay_day.try(:strftime, "%d/%m/%Y"), class: 'col-md-10' %></td>
              <td><%= text_field_tag "map[payment_maps][#{payment_map.id}][payment_value]", payment_map.payment_value, class: 'col-md-12' %></td>
              <td><%= text_field_tag "map[payment_maps][#{payment_map.id}][paid_value]", payment_map.paid_value, class: 'col-md-10' %></td>
              <td><%= text_field_tag "map[payment_maps][#{payment_map.id}][recipient]", payment_map.recipient, class: 'col-md-10' %></td>
              <td>
                <button type='button' class='ls-btn remove-Payment'>
                  <span class='ls-ico-remove'></span>
                </button></td>
            </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      
      <div class="row">
        <div class="col-md-10">
          <label class="ls-label col-md-10">
            <span class="ls-label-text"><%= label :attachment_pay, "Cheque:" %></span>
              <%= f.file_field :attachment_pay %>            
          </label>
        </div>
      </div>      
      
      
      <div class="row">
        <div class="col-md-10">
          <label class="ls-label col-md-10">
            <span class="ls-label-text"><%= f.label :payment_note, "Observação do pagamento:"%></span>
            <%= f.text_area :payment_note %>
          </label>
        </div>
      </div>        

    </div>
  </div>
</fieldset>

<div class="ls-actions-btn">
  <%#= submit_tag t('actions.create'), class: 'ls-btn-primary' %>
  <%= f.button  "Salvar", :type => "submit" , class: "ls-btn-primary"%>
  <%= link_to 'Voltar', maps_path, class: "ls-btn-darker" %>
</div>

<% end %>
