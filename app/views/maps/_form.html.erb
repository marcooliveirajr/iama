<%= form_for(@map) do |f| %>
<% if @map.errors.any? %>
<div id="error_explanation">
  <h2><%= pluralize(@map.errors.count, "error") %> prohibited this map from being saved:</h2>

  <ul>
    <% @map.errors.full_messages.each do |message| %>
    <li><%= message %></li>
    <% end %>
  </ul>
</div>
<% end %>

<fieldset>

  <div class="row">
    <div class="col-md-8">
      <label class="ls-label col-md-8">
        <span class="ls-label-text"><%=f.label :time_surgery, "Data/Hora" %></span>
        <%= f.datetime_select :time_surgery, {:order => [:day, :month, :year], :datetime_separator => " - ", :use_month_names=>["Janeiro" ,"Fevereiro", "Março", "Abril" ,"Maio", "Junho","Julho", "Agosto", "Setembro", "Outubro", "Novembro", "Dezembro" ],:start_year => Time.now.year, :end_year => Time.now.year + 5 }%>
      </label>
    </div>
  </div>

  <div class="row">
    <div class="col-md-8">
      <label class="ls-label col-md-8">
        <span class="ls-label-text"><%= f.label :hospital_id, "Hospital" %></span>
        <div class="ls-custom-select">
          <%= f.collection_select(:hospital_id, Hospital.all, :id, :name, class: "ls-state ls-select", prompt: true) %>
        </div>
      </label>
    </div>
  </div>

  <div class="row">
    <div class="col-md-8">
      <label class="ls-label col-md-8">
        <span class="ls-label-text"><%= f.label :bedroom_id, "Quarto" %></span>
        <div class="ls-custom-select">
         <%= f.collection_select(:bedroom_id, @map.bedroom_hospital, :id, :name, class: "ls-state ls-select", prompt: true) %>
       </div>
     </label>
   </div>
 </div>

 <div class="row">
  <div class="col-md-8">
    <label class="ls-label col-md-8">
      <span class="ls-label-text"><%= f.label :patient_id, "Paciente" %></span>
      <div class="ls-custom-select">
        <%= f.collection_select(:patient_id, Patient.all, :id, :name, class: "ls-state ls-select", prompt: true) %>
      </div>
    </label>
  </div>
</div>

<div class="row">
  <div class="col-md-8">
    <label class="ls-label col-md-8">
      <span class="ls-label-text"><%= f.label :health_terminology_id, "Procedimento" %></span>
      <div class="ls-custom-select">
        <%= f.collection_select(:health_terminology_id, HealthTerminology.all, :id, :description_tuss, class: "ls-state ls-select", prompt: true) %>
      </div>
    </label>
  </div>
</div>

<div class="row">
  <div class="col-md-8">
    <label class="ls-label col-md-8">
      <span class="ls-label-text"><%= f.label :surgeon_id, "Cirugião" %></span>
      <div class="ls-custom-select">
        <%= f.collection_select(:surgeon_id, Surgeon.all, :id, :name, class: "ls-state ls-select", prompt: true) %>
      </div>
    </label>
  </div>
</div>

<div class="row">
  <div class="col-md-8">
    <label class="ls-label col-md-8">
      <span class="ls-label-text"><%= f.label :anesthetist_id, "Anestesista" %></span>
      <div class="ls-custom-select">
        <%= f.collection_select(:anesthetist_id, Anesthetist.all, :id, :name, class: "ls-state ls-select", prompt: true) %>
      </div>
    </label>
  </div>
</div>

<div class="row">
  <div class="col-md-8">
    <label class="ls-label col-md-8">
      <span class="ls-label-text"><%= f.label :health_insurance_id, "Convênio Médico" %></span>
      <div class="ls-custom-select">
        <%= f.collection_select(:health_insurance_id, HealthInsurance.all, :id, :name, class: "ls-state ls-select", prompt: true) %>
      </div>
    </label>
  </div>
</div>

<div class="row">
  <div class="col-md-8">
    <label class="ls-label col-md-8">
      <span class="ls-label-text"><%= f.label :note, "Observação" %></span>
      <%= f.text_area :note %>
    </label>
  </div>
</div>

<div class="row">
  <div class="col-md-8">

  <%= form_tag payment_maps_path, html: { class: 'ls-form ls-form-horizontal' } do |f| %>
    <label class="ls-label col-md-12">
      <%= label_tag t('helpers.label.payment_map.payment') %>
      <div class="row">
        <div class="ls-prefix-group col-md-8">
          <input type='text' id='service_key' />
          <a href="#" id='add-Payment' class="ls-label-text-prefix ls-bg-white">+</a>
        </div>
      </div>
    </label>

    <div class='col-md-8'>
      <table id='keys', class='ls-table'>
        <thead>
          <th>Parcela</th>
          <th>Vencimento</th>
          <th>Valor</th>
          <th>Valor Pago</th>
          <th>Remover</th>
        </thead>

        <tbody>
        </tbody>
      </table>
    </div>

    <%= hidden_field_tag :type, @type %>
    <%= hidden_field_tag :reference, @reference %>

    <label class='col-md-8'>
      <%= submit_tag t('actions.create'), class: 'ls-btn-primary', disabled: 'disabled' %>
    </label>
  <% end %>

  </div>
</div>


</fieldset>

<div class="ls-actions-btn">
  <%= f.button  "Salvar", :type => "submit" , class: "ls-btn-primary"%>
  <%= link_to 'Voltar', maps_path, class: "ls-btn-darker" %>
</div>

<% end %>
