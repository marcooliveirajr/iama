<%= form_for @map, html: { :multipart => true, class: 'ls-form ls-form-horizontal' } do |f| %>

<fieldset>

  <ul class="ls-tabs-nav">
    <li class="ls-active"><a href="#track">Dados da Cirurgia</a></li>
    <li><a href="#receipt">Dados do Recibo</a></li>
    <li><a href="#contact">Dados do Pagamento</a></li>
  </ul>

  <div class="ls-tabs-container">
    <div id="track" class="ls-tab-content ls-active">

