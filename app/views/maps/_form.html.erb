          <label class="ls-label col-md-4">
          <b class="ls-label-text"><%= f.label :via_unique3, "Via Única:" %></b>
          <div class="ls-custom-select">
              <%= f.select :via_unique3, [['Nenhum', nil], ['Sim', true], ['Não', false]] %>
          </div>
          </label>
        </div>
      </div>
  
      <div class="row">
        <div class="col-md-10">
          <label class="ls-label col-md-10">
            <span class="ls-label-text"><%= f.label :tuss4_id, "Procedimento 4 - TUSS:"%></span>
            <div class="ls-prefix-group">
              <a href="#" id='clear_tuss4' class='ls-label-text-prefix ls-bg-white ls-ico-remove'></a>
              <div class="ls-custom-select">
                <%= f.collection_select(:tuss4, HealthTerminology.all, :id, :description_tuss, class: 'ls-select', prompt: true, include_blank: 'Selecione') %>
