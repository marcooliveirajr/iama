<h1 class="ls-title-intro ls-ico-text">Cirurgia</h1>
<%= flash_messages %>
<div data-ls-module="collapse" data-target="#acordeon0" class="ls-collapse ">
  <a href="#" class="ls-collapse-header">
    <h3 class="ls-collapse-title">Dados da Cirurgia</h3>
  </a>
  <div class="ls-collapse-body" id="acordeon0">

    <div class="ls-box">
      <div class="row">
        <div class="col-md-12">
          <table class="ls-table ls-table-striped ls-no-hover ls-sm-space ls-no-margin-top">

            <tbody>
              <tr> 
                <td> Anestesista: 
                  <label class="ls-title-6"><%= @map.anesthetist.try(:name) %>
                  </label> 
                </td> 
              </tr>

              
            <% if @map.anesthetist1? %>
              <tr> 
                <td> Anestesista 2: 
                  <label class="ls-title-6"><%= find_desc_anesthetists(@map.anesthetist1) %>
                  </label> 
                </td> 
              </tr>
            <% end %> 
            <% if @map.anesthetist2? %>
              <tr> 
                <td> Anestesista 3: 
                  <label class="ls-title-6"><%= find_desc_anesthetists(@map.anesthetist2) %>
                  </label> 
                </td> 
              </tr>  
            <% end %>   

              <tr> 
                <td> Cirurgião: 
                  <label class="ls-title-6"><%= @map.surgeon.try(:name) %>
                  </label> 
                </td> 
              </tr>

            <% if @map.surgeon1? %>  
              <tr> 
                <td> Cirurgião 2: 
                  <label class="ls-title-6"><%= find_desc_surgeon(@map.surgeon1) %>
                  </label> 
                </td> 
              </tr>  
            <% end %>  
            <% if @map.surgeon2? %>
              <tr> 
                <td> Cirurgião 3: 
                  <label class="ls-title-6"><%= find_desc_surgeon(@map.surgeon2) %>
                  </label> 
                </td> 
              </tr>  
            <% end %>                
              <tr> 
                <td> Convênio Médico: 
                  <label class="ls-title-6"><%= @map.health_insurance.try(:name) %>
                  </label> 
                </td> 
              </tr>
              <tr> 
                <td> Plano do Convênio: 
                  <label class="ls-title-6"><%= @map.health_plan.try(:name) %>
                  </label> 
                </td> 
              </tr>
              <tr> 
                <td> Data/Hora: 
                  <label class="ls-title-6"><%= @map.time_surgery.strftime("%d/%m/%Y %H:%M") %>
                  </label> 
                </td> 
              </tr>
              <tr> 
                <td> Hospital: 
                  <label class="ls-title-6"><%= @map.hospital.try(:name) %>
                  </label> 
                </td> 
              </tr>
              <tr> 
                <td> Hora inicial: 
                  <label class="ls-title-6"><%= @map.try(:start_time).try(:strftime, "%d/%m/%Y %H:%M") %>
                  </label> 
                </td> 
              </tr>
              <tr> 
                <td> Hora final: 
                  <label class="ls-title-6"><%= @map.try(:end_time).try(:strftime, "%d/%m/%Y %H:%M") %>
                  </label> 
                </td> 
              </tr>
              <tr> 
                <td> Paciente: 
                  <label class="ls-title-6"><%= @map.patient.try(:name) %>
                  </label> 
                </td> 
              </tr>
              <tr> 
                <td> Matrícula: 
                  <label class="ls-title-6"><%= @map.try(:registration) %>
                  </label> 
                </td> 
              </tr>
              <tr> 
                <td> Senha da Internação: 
                  <label class="ls-title-6"><%= @map.try(:password) %>
                  </label> 
                </td> 
              </tr>
              <tr> 
                <td> Código da Internação: 
                  <label class="ls-title-6"><%= @map.try(:hospitalization) %>
                  </label> 
                </td> 
              </tr>
            <% if @map.bedroom_id? %>
              <tr> 
                <td> Quarto: 
                  <label class="ls-title-6"><%= @map.bedroom.try(:name) %>
                  </label> 
                </td> 
              </tr>
            <% end %>  
              <tr> 
                <td> Procedimento: 
                  <label class="ls-title-6"><%= @map.health_terminology.try(:description_tuss) %>
                  </label> 
                </td> 
              </tr>
              <tr> 
                <td> Código TUSS: 
                  <label class="ls-title-6"><%= @map.health_terminology.try(:code_tuss) %>
                  </label> 
                </td> 
              </tr>
              <tr> 
                <td> Porte: 
                  <label class="ls-title-6"><%= @map.health_terminology.try(:measure) %>
                  </label> 
                </td> 
              </tr>

            <% if exists_tuss2? %>
              <tr> 
                <td> Procedimento 2: 
                  <label class="ls-title-6"><%= find_desc_tuss(@map.tuss2) %>
                  </label> 
                </td> 
              </tr>
              <tr> 
                <td> Código TUSS: 
                  <label class="ls-title-6"><%= find_code_tuss(@map.tuss2) %>
                  </label> 
                </td> 
              </tr>
              <tr> 
                <td> Porte: 
                  <label class="ls-title-6"><%= find_measure_tuss(@map.tuss2) %>
                  </label> 
                </td> 
              </tr>
              <tr> 
                <td> Via única: 
                  <% if @map.via_unique2 == true %>
                    <label class="ls-title-6">Sim</label>
                  <% else %>
                    <label class="ls-title-6">Não</label>
                  <% end %>
                </td> 
              </tr>
            <% end %> 

            <% if exists_tuss3? %>
              <tr> 
                <td> Procedimento 3: 
                  <label class="ls-title-6"><%= find_desc_tuss(@map.tuss3) %>
                  </label> 
                </td> 
              </tr>
              <tr> 
                <td> Código TUSS: 
                  <label class="ls-title-6"><%= find_code_tuss(@map.tuss3) %>
                  </label> 
                </td> 
              </tr>
              <tr> 
                <td> Porte: 
                  <label class="ls-title-6"><%= find_measure_tuss(@map.tuss3) %>
                  </label> 
                </td> 
              </tr>
              <tr> 
                <td> Via única: 
                  <% if @map.via_unique3 == true %>
                    <label class="ls-title-6">Sim</label>
                  <% else %>
                    <label class="ls-title-6">Não</label>
                  <% end %>
                </td> 
              </tr>
            <% end %>

            <% if exists_tuss4? %>
              <tr> 
                <td> Procedimento 4: 
                  <label class="ls-title-6"><%= find_desc_tuss(@map.tuss4) %>
                  </label> 
                </td> 
              </tr>
              <tr> 
                <td> Código TUSS: 
                  <label class="ls-title-6"><%= find_code_tuss(@map.tuss4) %>
                  </label> 
                </td> 
              </tr>
              <tr> 
                <td> Porte: 
                  <label class="ls-title-6"><%= find_measure_tuss(@map.tuss4) %>
                  </label> 
                </td> 
              </tr>
              <tr> 
                <td> Via única: 
                  <% if @map.via_unique4 == true %>
                    <label class="ls-title-6">Sim</label>
                  <% else %>
                    <label class="ls-title-6">Não</label>
                  <% end %>
                </td> 
              </tr>
            <% end %>  
            <% if exists_tuss5? %>
              <tr> 
                <td> Procedimento 5: 
                  <label class="ls-title-6"><%= find_desc_tuss(@map.tuss5) %>
                  </label> 
                </td> 
              </tr>
              <tr> 
                <td> Código TUSS: 
                  <label class="ls-title-6"><%= find_code_tuss(@map.tuss5) %>
                  </label> 
                </td> 
              </tr>
              <tr> 
                <td> Porte: 
                  <label class="ls-title-6"><%= find_measure_tuss(@map.tuss5) %>
                  </label> 
                </td> 
              </tr>
              <tr> 
                <td> Via única: 
                  <% if @map.via_unique5 == true %>
                    <label class="ls-title-6">Sim</label>
                  <% else %>
                    <label class="ls-title-6">Não</label>
                  <% end %>
                </td> 
              </tr>
            <% end %>
            
              <tr> 
                <td> Observação: 
                  <label class="ls-title-6"><%= @map.note %>
                  </label> 
                </td> 
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<% if exists_receipt? %>
<div data-ls-module="collapse" data-target="#acordeon3" class="ls-collapse ">
  <a href="#" class="ls-collapse-header">
    <h3 class="ls-collapse-title">Dados do Recibo</h3>
  </a>
  <div class="ls-collapse-body" id="acordeon3">

    <div class="ls-box">
      <div class="row">
        <div class="col-md-12">
          <table class="ls-table ls-table-striped ls-no-hover ls-sm-space ls-no-margin-top">

            <tbody>
              <tr> 
                <td> Recibo: 
                  <label class="ls-title-6"><%= @map.receipt.try(:name) %>
                  </label> 
                </td> 
              </tr>              
              <tr> 
                <td> Data de emissão do recibo: 
                  <label class="ls-title-6"><%= @map.try(:receipt_day).try(:strftime, "%d/%m/%Y") %>
                  </label> 
                </td> 
              </tr>
              <tr> 
                <td> Valor do recibo: 
                  <label class="ls-title-6"><%= @map.try(:receipt_value) %>
                  </label> 
                </td> 
              </tr>
              <tr> 
                <td> Observação do recibo: 
                  <label class="ls-title-6"><%= @map.receipt_note %>
                  </label> 
                </td> 
              </tr>                
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
<% end %>


<% if exists_payment_maps? %>
<div data-ls-module="collapse" data-target="#acordeon2" class="ls-collapse ">
  <a href="#" class="ls-collapse-header">
    <h3 class="ls-collapse-title">Dados do Pagamento</h3>
  </a>
  <div class="ls-collapse-body" id="acordeon2">


    <div class="ls-box">
      <div class="row">
        <div class="col-md-12">
          <table class="ls-table ls-table-striped ls-no-hover ls-sm-space ls-no-margin-top">

            <tbody>
              <tr> <td> Método de Pagamento: <label class="ls-title-6"><%= @map.payment_method.try(:name) %></label> </td> </tr>
            </tbody>
          </table>
        </div>


        <div class="ls-box">
          <div class="row">
            <div class="col-md-12">
              <table class='ls-table ls-table-striped ls-no-hover ls-sm-space ls-no-margin-top'>
                <thead>
                  <th>Parcela</th>
                  <th>Data Cobrança</th>
                  <th>Data Pagto</th>
                  <th>Valor Cobrado</th>
                  <th>Valor Pago</th>
                  <th>Beneficiário</th>
                </thead>
                <tbody>
                  <% @map.payment_maps.each do |payment_map| %>
                  <tr>
                    <td> <label class="ls-title-6"><%= payment_map.payment_id %></label> </td>
                    <td> <label class="ls-title-6"><%= payment_map.try(:payment_date).try(:strftime, "%d/%m/%Y") %></label> </td>
                    <td> <label class="ls-title-6"><%= payment_map.try(:pay_day).try(:strftime, "%d/%m/%Y") %></label> </td> 
                    <td> <label class="ls-title-6"><%= payment_map.payment_value %></label> </td>
                    <td> <label class="ls-title-6"><%= payment_map.paid_value %></label> </td>
                    <td> <label class="ls-title-6"><%= payment_map.recipient %></label> </td>
                  </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<% end %>

<%= link_to 'Editar', edit_map_path(@map) , class: "ls-btn-darker" %>
<%= link_to 'Voltar', maps_path, class: "ls-btn-darker" %>
<a><%= link_to 'Cadastrar Cirurgia', new_map_path(@map) , class: "ls-btn-primary" %></a>