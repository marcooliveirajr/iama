<h1 class="ls-title-intro ls-ico-text">Mapa</h1>
<div class="ls-box">
<div class="row">
  <div class="col-md-12">
    <div class="ls-box">
      <p><strong>Time surgery:</strong></p>
      <p class="ls-break-text"><%= @map.time_surgery %></p>
      <hr>
      <p><strong>Hospital:</strong></p>
      <p class="ls-break-text"><%= @map.hospital.name %></p>
      <hr>
      <p><strong>Bedroom:</strong></p>
      <p class="ls-break-text"><%= @map.bedroom.name %></p>
      <hr>
      <p><strong>Patient:</strong></p>
      <p class="ls-break-text"><%= @map.patient.name %></p>
      <hr>
      <p><strong>Health terminology:</strong></p>
      <p class="ls-break-text"><%= @map.health_terminology.description_tuss %></p>
      <hr>
      <p><strong>Surgeon:</strong></p>
      <p class="ls-break-text"><%= @map.surgeon.name %></p>
      <hr>
      <p><strong>Anesthetist:</strong></p>
      <p class="ls-break-text"><%= @map.anesthetist.name %></p>
      <hr>
      <p><strong>Health insurance:</strong></p>
      <p class="ls-break-text"><%= @map.health_insurance.name %></p>
      <hr>
      <p><strong>Note:</strong></p>
      <p class="ls-break-text"><%= @map.note %></p>
    </div>
  </div>
</div>
</div>

<%= link_to 'Editar', edit_map_path(@map) , class: "ls-btn-darker" %>
<%= link_to 'Voltar', maps_path, class: "ls-btn-darker" %>
