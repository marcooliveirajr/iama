<div class="row">
  <div class="col-md-8">
    <label class="ls-label col-md-12">
      <%= label_tag t('helpers.label.payment_map.payment') %>
      <div class="row">
        <div class="ls-prefix-group col-md-8">
          <input type='text' id='value' />
          <a href="#" id='add-Payment' class="ls-label-text-prefix ls-bg-white">+</a>
        </div>
      </div>
    </label>

    <div class='col-md-8'>
      <table id='keys', class='ls-table'>
        <thead>
          <th>Parcela</th>
          <th>Vencimento</th>
          <th>Valor</th>
          <th>Valor Pago</th>
          <th>Remover</th>
        </thead>
        <tbody>
          <% @map.payment_maps.each do |payment_map| %>
          <tr>
            <td>1</td>
            <td><%= payment_map.payment_id %></td>
            <td><%= payment_map.payment_date %></td>
            <td><%= payment_map.payment_value %></td>
            <td><%= payment_map.paid_value %></td>
            <td>
          </tr>
          <% end %>
          </tbody>
        </table>
      </div>
      <%= hidden_field_tag :type, @type %>
    </div>
  </div>
