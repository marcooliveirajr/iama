<h1 class="ls-title-intro ls-ico-text">Plantonistas</h1>
<%= flash_messages %>
<hr>
<tbody>
  <%# @on_duties.where(on_duty_date: DateTime.now).order("on_duty_date asc").each do |on_duty| %>
  <% @on_duties.where(":agora BETWEEN on_duty_date AND end_time", {:agora => DateTime.now.utc}).order("on_duty_date asc").each do |on_duty| %>

  <div class="ls-list">
    <header class="ls-list-header">
      <div class="ls-list-title col-md-9">
        <span class="ls-list-label">Anestesista - Data do Plantão</span>
        <strong><%= on_duty.anesthetist.try(:name) %> - <%= on_duty.try(:on_duty_date).strftime("%d/%m/%Y %H:%M") %> até <%= on_duty.try(:end_time).strftime("%d/%m/%Y %H:%M") %></strong>
      </div>
      </header>
      <div class="ls-list-content ">
        <div class="col-sm-4">
          <span class="ls-list-label">Telefone</span>
          <strong><%= on_duty.anesthetist.try(:phone) %></strong>
        </div>
        <div class="col-sm-4">
          <span class="ls-list-label">Celular</span>
          <strong><%= on_duty.anesthetist.try(:cellphone) %></strong>
        </div>
      </div>

      <div class="ls-list-content ">
        <div class="col-sm-4">
            <span class="ls-list-label">Observação</span>
            <strong><%= on_duty.note %></strong>
        </div>
      </div>
    </div>


  <% end %>
</tbody>
