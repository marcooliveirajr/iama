<h1 class="ls-title-intro ls-ico-text">Plantonistas</h1>
<%= flash_messages %>
<h3 class="ls-title-3">Plantão <%= Time.zone.now.midnight.strftime("%d/%m/%Y")%> </h3>
<hr>
<tbody>
  <% @on_duties.where(on_duty_date: Time.zone.now.midnight).order("on_duty_date asc").each do |on_duty| %>

  <div class="ls-list">
    <header class="ls-list-header">
      <div class="ls-list-title col-md-9">
        <span class="ls-list-label">Anesteista</span>
        <strong><%= on_duty.anesthetist.try(:name) %></strong>
      </div>
      </header>
      <div class="ls-list-content ">
        <div class="col-sm-4">
          <span class="ls-list-label">Telefone</span>
          <strong><%= on_duty.anesthetist.try(:phone) %></strong>
        </div>
        <div class="col-sm-4">
          <span class="ls-list-label">Email</span>
          <strong><%= on_duty.anesthetist.try(:email) %></strong>
        </div>
      </div>

      <div class="ls-list-content ">
        <div class="col-sm-4">
            <span class="ls-list-label">Observação</span>
            <strong><%= on_duty.note %></strong>
        </div>
      </div>
    </div>


  <% end %>
</tbody>
