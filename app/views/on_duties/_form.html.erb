<%= form_for(@on_duty, html: { class: "ls-form row" }) do |f| %>
  <fieldset>

    <div class="row">
      <div class="col-md-8">
        <label class="ls-label col-md-4 <%= class_error @on_duty, :on_duty_date %>">
        <span class="ls-label-text"><%= f.label :on_duty_date, "Data Início do Plantão:" %></span>
        <div class='input-group date' id='start_on_duty'>
            <%= f.text_field :on_duty_date, value: @on_duty.try(:on_duty_date).try(:strftime, "%d/%m/%Y %H:%M") , class: 'form-control'%>
            <span class="input-group-addon">
              <span class="glyphicon glyphicon-calendar"></span>
            </span>
          </div>
        <%#= f.text_field :on_duty_date, value: @on_duty.try(:on_duty_date).try(:strftime, "%d/%m/%Y"), class: 'datepicker ls-mask-date', :placeholder => 'dd/mm/aaaa' %>
        <%= show_message_error @on_duty, :on_duty_date %>
      </label>
     </div>
    </div>

    <div class="row">
      <div class="col-md-8">
        <label class="ls-label col-md-4 <%= class_error @on_duty, :end_time %>">
          <span class="ls-label-text"><%= f.label :end_time, "Data Final do Plantão:" %></span>
          <div class='input-group date' id='end_on_duty'>
            <%= f.text_field :end_time, value: @on_duty.try(:end_time).try(:strftime, "%d/%m/%Y %H:%M") , class: 'form-control'%>
            <span class="input-group-addon">
              <span class="glyphicon glyphicon-calendar"></span>
            </span>
          </div>
          <%= show_message_error @on_duty, :end_time %>
        </label>
      </div>
    </div>

    <div class="row">
      <div class="col-md-8">
        <label class="ls-label col-md-8 <%= class_error @on_duty, :anesthetist_id %>">
        <span class="ls-label-text"><%= f.label :anesthetist_id, "Anestesista:" %></span>
          <div class="ls-custom-select">
            <%= f.collection_select(:anesthetist_id, Anesthetist.all, :id, :name, class: "ls-state ls-select", prompt: true) %>
          </div>
          <%= show_message_error @on_duty, :anesthetist_id %>
        </label>
      </div>
    </div>

    <div class="row">
      <div class="col-md-10">
        <label class="ls-label col-md-10">
          <span class="ls-label-text"><%= f.label :note, "Observação:" %></span>
          <%= f.text_area :note %>
        </label>
      </div>
    </div>

  </fieldset>

  <div class="ls-actions-btn">
    <%= f.button  "Salvar", :type => "submit" , class: "ls-btn-primary"%>
    <%= link_to 'Voltar', on_duties_path, class: "ls-btn-darker" %>
  </div>

<% end %>


