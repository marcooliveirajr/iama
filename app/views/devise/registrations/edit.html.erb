<h2 class="ls-title-intro ls-ico-user">Editar usuário</h2>

<%= form_for(resource, :as => resource_name, :url => registration_path(resource_name), :html => { :method => :put }) do |f| %>
<fieldset>
  <div style="width: 260px" class="ls-alert-success ls-dismissable" role="alert"><%= devise_error_messages! %></div>
      <label class="ls-label">
        <b class="ls-label-text ls-hidden-accessible">Email</b>
        <%= f.email_field :email, :autofocus => true, :class => "ls-login-bg-user ls-field-lg", :placeholder => "Usuário" %>
      </label>

  <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
    <div>Currently waiting confirmation for: <%= resource.unconfirmed_email %></div>
  <% end %>

      <label class="ls-label">
        <b class="ls-label-text ls-hidden-accessible">Nova Senha</b>
          <%= f.password_field :password, :autocomplete => "off", :class => "ls-login-bg-password ls-field-lg", :placeholder => "Nova Senha" %>
      </label>

      <label class="ls-label">
        <b class="ls-label-text ls-hidden-accessible">Confirme a nova senha</b>
          <%= f.password_field :password_confirmation, :autocomplete => "off", :class => "ls-login-bg-password ls-field-lg", :placeholder => "Confirme a nova senha" %>
      </label>

      <label class="ls-label">
        <b class="ls-label-text ls-hidden-accessible">Senha atual</b>
          <%= f.password_field :current_password, :autocomplete => "off", :class => "ls-login-bg-password ls-field-lg", :placeholder => "Senha atual" %>
      </label>

      <%= f.submit "Atualizar", :class => "ls-btn-primary ls-btn-block ls-btn-lg" %>

<% end %>


      <p class="ls-txt-center ls-login-signup">
        <%= link_to "Voltar", :back %>
      </p>
<fieldset>
