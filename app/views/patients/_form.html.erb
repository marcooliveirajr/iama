<%= form_for(@patient, html: { class: "ls-form row" }) do |f| %>
  <fieldset>

    <div class="row">
      <div class="col-md-8">
        <label class="ls-label col-md-8 <%= class_error @patient, :name %>">
        <span class="ls-label-text"><%= f.label :name, "Nome:" %></span>
        <%= f.text_field :name %>
        <%= show_message_error @patient, :name %>
      </label>
     </div>
    </div>

    <div class="row">
      <div class="col-md-8">
        <label class="ls-label col-md-3">
        <span class="ls-label-text"><%= f.label :rg, "RG:" %></span>
        <%= f.text_field :rg, class: 'ls-mask-rg', placeholder: '00.000.000-0', maxlength: '9', autocomplete: 'off' %>
      </label>
     </div>
    </div>

    <div class="row">
      <div class="col-md-8">
        <label class="ls-label col-md-3">
        <span class="ls-label-text"><%= f.label :cpf, "CPF:" %></span>
        <%= f.text_field :cpf, class: 'ls-mask-cpf', placeholder: '000.000.000-00', maxlength: '14', autocomplete: 'off' %>
      </label>
     </div>
    </div>

    <div class="row">
      <div class="col-md-8">
        <label class="ls-label col-md-3">
        <span class="ls-label-text"><%= f.label :age, "Idade:" %></span>
        <%= f.text_field :age, autocomplete: 'off' %>
      </label>
     </div>
    </div>

    <div class="row">
      <div class="col-md-8">
        <label class="ls-label col-md-3">
        <span class="ls-label-text"><%= f.label :phone, "Telefone:" %></span>
        <%= f.text_field :phone, class: 'ls-mask-phone', placeholder: '(99) 9999-9999' %>
      </label>
      </div>
    </div>

    <div class="row">
      <div class="col-md-8">
        <label class="ls-label col-md-3">
        <span class="ls-label-text"><%= f.label :phone, "Celular:" %></span>
        <%= f.text_field :cellphone, class: 'ls-mask-phone', placeholder: '(99) 99999-9999' %>
      </label>
      </div>
    </div>

    <div class="row">
      <div class="col-md-8">
        <label class="ls-label col-md-8 <%= class_error @patient, :email %>">
        <span class="ls-label-text"><%= f.label :email, "Email:" %></span>
        <%= f.text_field :email %>
        <%= show_message_error @patient, :email %>
        </label>
      </div>
    </div>

    <div class="row">
      <div class="col-md-8">
        <label class="ls-label col-md-3 ls-v-align-middle <%= class_error @patient, "CEP" %>">
          <span class="ls-label-text"><%= f.label :postal_code, "CEP:" %></span>
          <%= f.text_field :postal_code, class: 'ls-mask-cep', placeholder: '00000-000', id: 'address_postal_code' %>
          <%= show_message_error @patient, "CEP" %>
          <span class="ls-label col-md-3 ls-float-none"></span>
          <%= link_to 'Não sei o CEP', "http://www.buscacep.correios.com.br/", target: "_blank" %>
      </label>
      </div>
    </div>

    <div class="row">
      <div class="col-md-8">
        <label class="ls-label col-md-8">
        <span class="ls-label-text"><%= f.label :address, "Endereço:" %></span>
        <%= f.text_field :address, id: 'id_address' %>
      </label>
      </div>
    </div>

    <div class="row">
      <div class="col-md-8">
        <label class="ls-label col-md-2">
        <span class="ls-label-text"><%= f.label :address_number, "Número:" %></span>
        <%= f.text_field :address_number %>
      </label>
      </div>
    </div>

    <div class="row">
      <div class="col-md-8">
        <label class="ls-label col-md-3">
        <span class="ls-label-text"><%= f.label :address_complement, "Complemento:" %></span>
        <%= f.text_field :address_complement %>
      </label>
      </div>
    </div>

    <div class="row">
      <div class="col-md-8">
        <label class="ls-label col-md-4">
        <span class="ls-label-text"><%= f.label :district, "Bairro:" %></span>
        <%= f.text_field :district, id: 'id_district' %>
      </label>
      </div>
    </div>

    <div class="row">
      <div class="col-md-8">
        <label class="ls-label col-md-4">
        <span class="ls-label-text"><%= f.label :city, "Cidade:" %></span>
        <%= f.text_field :city, id: 'id_city' %>
      </label>
      </div>
    </div>

    <div class="row">
      <div class="col-md-8">
        <label class="ls-label col-md-4">
        <span class="ls-label-text"><%= f.label :state, "Estado:" %></span>
          <div class="ls-custom-select">
            <%= f.select(:state, Carmen::state_codes('BR'), {prompt: true}, class: "ls-state ls-select", id: "id_state" ) %>
          </div>
        </label>
      </div>
    </div>

    <div class="row">
      <div class="col-md-10">
        <label class="ls-label col-md-10">
          <span class="ls-label-text"><%= f.label :note, "Observação:" %></span>
          <%= f.text_area :note %>
        </label>
      </div>
    </div>

 </fieldset>

<div class="ls-actions-btn">
    <%= f.button  "Salvar", :type => "submit" , class: "ls-btn-primary"%>
    <%= link_to 'Voltar', patients_path, class: "ls-btn-darker" %>
</div>


 <% end %>

<% content_for :javascript do %>

  var configs_postal_code = { fields: { address: "#id_address", district: "#id_district", city: "#id_city", state: "#id_state" } }

  $(document).ready(function(){
    $("#address_postal_code").on({change: function(){ address.search(configs_postal_code, $(this).val()); }});

  });

<% end %>
