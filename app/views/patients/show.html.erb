<h1 class="ls-title-intro ls-ico-user">Pacientes</h1>
<%= flash_messages %>
<div class="ls-box">
  <div class="row">
    <div class="col-md-12">
        <table class="ls-table ls-table-striped ls-no-hover ls-sm-space ls-no-margin-top">
          <tbody>
            <tr> 
              <td> Nome: 
                <label class="ls-title-6"><%= @patient.name %>
                </label> 
              </td> 
            </tr>
            <tr> 
              <td> RG: 
                <label class="ls-title-6"><%= @patient.rg %>
                </label> 
              </td> 
            </tr>
            <tr> 
              <td> CPF: 
                <label class="ls-title-6"><%= @patient.cpf %>
                </label> 
              </td> 
            </tr>
            <tr> 
              <td> Idade: 
                <label class="ls-title-6"><%= @patient.age %>
                </label> 
              </td> 
            </tr>
            <tr> 
              <td> Telefone: 
                <label class="ls-title-6"><%= @patient.phone %>
                </label> 
              </td> 
            </tr>
            <tr> 
              <td> Celular: 
                <label class="ls-title-6"><%= @patient.cellphone %>
                </label> 
              </td> 
            </tr>
            <tr> 
              <td> Email: 
                <label class="ls-title-6"><%= @patient.email %>
                </label> 
              </td> 
            </tr>
            <tr> 
              <td> CEP: 
                <label class="ls-title-6"><%= @patient.postal_code %>
                </label> 
              </td> 
            </tr>
            <tr> 
              <td> Endereço: 
                <label class="ls-title-6"><%= @patient.address %>
                </label> 
              </td> 
            </tr>
            <tr> 
              <td> Número: 
                <label class="ls-title-6"><%= @patient.address_number %>
                </label> 
              </td> 
            </tr>
            <tr> 
              <td> Complemento: 
                <label class="ls-title-6"><%= @patient.address_complement %>
                </label> 
              </td> 
            </tr>
            <tr> 
              <td> Bairro: 
                <label class="ls-title-6"><%= @patient.district %>
                </label> 
              </td> 
            </tr>
            <tr> 
              <td> Cidade: 
                <label class="ls-title-6"><%= @patient.city %>
                </label> 
              </td> 
            </tr>
            <tr> 
              <td> Estado: 
                <label class="ls-title-6"><%= @patient.state %>
                </label> 
              </td> 
            </tr>
            <tr> 
              <td> Observação: 
                <label class="ls-title-6"><%= @patient.note %>
                </label> 
              </td> 
            </tr>
          </tbody>
        </table>
    </div>
  </div>
</div>

<%= link_to 'Editar', edit_patient_path(@patient) , class: "ls-btn-darker" %>
<%= link_to 'Voltar', patients_path, class: "ls-btn-darker" %>
