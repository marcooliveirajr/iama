<%= form_for(@category, html: { class: "ls-form row" }) do |f| %>

  <fieldset>

    <div class="row">
      <div class="col-md-8">
        <label class="ls-label col-md-8 <%= class_error @category, :name %>">
        <span class="ls-label-text"><%= f.label :name, "Nome" %></span>
        <%= f.text_field :name %>
        <%= show_message_error @category, :name %>
      </label>
     </div>
    </div>

    <div class="row">
      <div class="col-md-8">
        <label class="ls-label col-md-4">
        <b class="ls-label-text"><%= f.label :input_type, "Entrada / Saída" %></b>
        <div class="ls-custom-select">
            <%= f.select :input_type, [['Nenhum', ''], ['Entrada', 'Entrada'], ['Saída', 'Saída']] %>
        </div>
        </label>
      </div>
    </div>

 </fieldset>

<div class="ls-actions-btn">
    <%= f.button  "Salvar", :type => "submit" , class: "ls-btn-primary"%>
    <%= link_to 'Voltar', categories_path, class: "ls-btn-darker" %>
</div>

<% end %>
