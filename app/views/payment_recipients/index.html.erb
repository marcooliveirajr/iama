<h1 class="ls-title-intro ls-ico-text">Beneficiário de Pagamento</h1>
<%= flash_messages %>
<a><%= link_to 'Cadastrar Beneficiário de Pagamento', new_payment_recipient_path(@payment_recipient) , class: "ls-btn-primary" %></a>
<br></br>


<tbody>
  <% @payment_recipients.each do |payment_recipient| %>

  <div class="ls-list">
    <header class="ls-list-header">
      <div class="ls-list-title col-md-9">
        <strong><%= link_to payment_recipient.name, payment_recipient %></strong>
      </div>
      <div class="col-md-3 ls-txt-right">
        <div data-ls-module="dropdown" class="ls-dropdown ls-pos-right">
          <a href="#" class="ls-btn-primary">Administrar</a>
          <ul class="ls-dropdown-nav">
            <li><%= link_to 'Editar', edit_payment_recipient_path(payment_recipient) %></li>
            <li><%= link_to 'Visualizar', payment_recipient %></li>
            <li><%= link_to 'Excluir', payment_recipient_path(payment_recipient), data: { confirm: "Você tem certeza?" }, method: :delete, class: "ls-color-danger ls-divider" %></li>
          </ul>
        </div>
      </div>
    </header>
  </div>

  <% end %>
</tbody>

