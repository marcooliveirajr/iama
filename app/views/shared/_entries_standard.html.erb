<%= form_for(entrie, html: { class: "ls-form row" }) do |f| %>
  <% if entrie.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(@map.errors.count, "error") %> prohibited this entrie from being saved:</h2>

      <ul>
      <% entrie.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>
  
  <fieldset>

    <div class="row">
      <div class="col-md-8">
        <label class="ls-label col-md-8">
        <span class="ls-label-text"><%= f.label :name, "Nome" %></span>
        <%= f.text_field :name %>
      </label>
     </div>
    </div>

    <div class="row">
      <div class="col-md-8">
        <label class="ls-label col-md-4">
        <span class="ls-label-text"><%= f.label :kind, "Tipo" %></span>
        <%= f.text_field :kind %>
        </label>
      </div>
    </div>

    <div class="row">
      <div class="col-md-8">
        <label class="ls-label col-md-4">
        <span class="ls-label-text"><%= f.label :status, "Status" %></span>
        <%= f.text_field :status %>
        </label>
      </div>
    </div>

 </fieldset>

<div class="ls-actions-btn">
    <%= f.button  "Salvar", :type => "submit" , class: "ls-btn-primary"%>
    <%= link_to 'Voltar', path, class: "ls-btn-darker" %>
</div>


<% end %>
