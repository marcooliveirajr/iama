<!DOCTYPE html>
<html class="ls-theme-blue">
<head>
  <title> <%= SECRETS["site"]["title"] %> </title>
  <meta charset="utf-8">
  <meta content="IE=edge,chrome=1" http-equiv="X-UA-Compatible">
  <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no">
    <link rel="stylesheet" href="https://netdna.bootstrapcdn.com/bootstrap/3.1.1/css/bootstrap.min.css">
  <script src="https://code.jquery.com/jquery-2.2.4.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.4/moment.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.4/locale/pt-br.min.js"></script>
  
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datetimepicker/4.17.47/css/bootstrap-datetimepicker.min.css">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datetimepicker/4.17.47/js/bootstrap-datetimepicker.min.js"></script>
  
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css">
  <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/i18n/pt-BR.js"></script>

  <%= stylesheet_link_tag "application", SECRETS["locastyle"]["css"], :media => "screen" %>
  <%= csrf_meta_tags %>
  <%= javascript_importmap_tags %>
  <%= javascript_include_tag "application", "data-turbo-track": "reload" %>
</head>
<body>
  <div class="ls-topbar">
    <div class="ls-notification-topbar">
 
    <div class="ls-alerts-list ls-display-none">
      <a href="#" class="ls-ico-bell-o" data-counter="8" data-ls-module="topbarCurtain" data-target="#ls-notification-curtain"><span>Notificações</span></a>
      <a href="#" class="ls-ico-bullhorn" data-ls-module="topbarCurtain" data-target="#ls-help-curtain"><span>Ajuda</span></a>
      <a href="#" class="ls-ico-question" data-ls-module="topbarCurtain" data-target="#ls-feedback-curtain"><span>Sugestões</span></a>
    </div>
 
      <div data-ls-module="dropdown" class="ls-dropdown ls-user-account">
        <a href="#" class="ls-ico-user">
          <img src="https://www.gravatar.com/avatar/<%= Digest::MD5.hexdigest(current_user.email.try(:downcase)) if current_user %>?d=mm&s=32">
          <span class="ls-name"><%= current_user.name if current_user %></span>
        </a>
        <nav class="ls-dropdown-nav ls-user-menu" aria-hidden="false">
          <ul>
            <li><%= link_to "Sair", destroy_user_session_path, :method => :delete %></li>
          </ul>
        </nav>
      </div>
    </div>

    <span class="ls-show-sidebar ls-ico-menu"></span>
    <h1 class="ls-brand-name"><%= link_to SECRETS["site"]["name"], root_path, title: SECRETS["site"]["name"], class: "ls-ico-accessibility" %></h1>
  </div>
  <main class="ls-main ">

    <div class="container-fluid">
      <%= yield %>
      
      
      <footer class="ls-footer" role="contentinfo">
        <div class="ls-footer-info">
          <p class="ls-copy-right">Copyright © 2026 - Website desenvolvido por Mconsulting</p>
        </div>
      </footer>
    </div>

  </main>

  <%= render 'shared/menu' %>

  <script src="<%= SECRETS["locastyle"]["js"] %>" type="text/javascript"></script>
  <script type='text/javascript'>
    <%= yield :javascript %>
    // Reinicializa módulos do Locastyle após navegação Turbo (Rails 7)
    document.addEventListener('turbo:load', function() {
      if (typeof LS !== 'undefined' && LS.init) { LS.init(); }
    });
    document.addEventListener('turbo:render', function() {
      if (typeof LS !== 'undefined' && LS.init) { LS.init(); }
    });

    // Toggle robusto do menu lateral (sidebar) responsivo
    document.addEventListener('click', function(e) {
      var toggleBtn = e.target.closest('.ls-show-sidebar');
      if (toggleBtn) {
        e.preventDefault();
        e.stopPropagation();
        document.documentElement.classList.toggle('ls-sidebar-visible');
        return;
      }
      
      var sidebar = e.target.closest('.ls-sidebar');
      var topbar = e.target.closest('.ls-topbar');
      if (!sidebar && !topbar && document.documentElement.classList.contains('ls-sidebar-visible')) {
        document.documentElement.classList.remove('ls-sidebar-visible');
      }
    });
  </script>

</body>
</html>
