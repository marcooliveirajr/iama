<!DOCTYPE html>
<html class="ls-theme-blue">
<head>
  <title> <%= SECRETS["site"]["title"] %> </title>
  <meta charset="utf-8">
  <meta content="IE=edge,chrome=1" http-equiv="X-UA-Compatible">
  <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no">
    <link rel="stylesheet" href="https://netdna.bootstrapcdn.com/bootstrap/3.1.1/css/bootstrap.min.css">
  <script src="https://code.jquery.com/jquery-2.2.4.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.4/moment.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.4/locale/pt-br.min.js"></script>
  
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datetimepicker/4.17.47/css/bootstrap-datetimepicker.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css">

  <%= stylesheet_link_tag "application", SECRETS["locastyle"]["css"], :media => "screen" %>
  <%= csrf_meta_tags %>
  <%= javascript_importmap_tags %>
  <%= javascript_include_tag "legacy_application", "data-turbo-track": "reload" %>

  <!-- Carrega plugins do jQuery após o carregamento do bundle da aplicação para evitar sobrescrita -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datetimepicker/4.17.47/js/bootstrap-datetimepicker.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/i18n/pt-BR.js"></script>
  <script src="<%= SECRETS["locastyle"]["js"] %>" type="text/javascript" data-turbo-track="reload"></script>
</head>
<body>
  <div class="ls-topbar">
    <div class="ls-notification-topbar">
 
    <div class="ls-alerts-list ls-display-none">
      <a href="#" class="ls-ico-bell-o" data-counter="8" data-ls-module="topbarCurtain" data-target="#ls-notification-curtain"><span>Notificações</span></a>
      <a href="#" class="ls-ico-bullhorn" data-ls-module="topbarCurtain" data-target="#ls-help-curtain"><span>Ajuda</span></a>
      <a href="#" class="ls-ico-question" data-ls-module="topbarCurtain" data-target="#ls-feedback-curtain"><span>Sugestões</span></a>
    </div>
 
      <div class="ls-user-account" style="display:flex;align-items:center;gap:12px;">
        <img src="https://www.gravatar.com/avatar/<%= Digest::MD5.hexdigest(current_user.email.try(:downcase)) if current_user %>?d=mm&s=32" style="border-radius:50%;">
        <span class="ls-name" style="color:#fff;"><%= current_user.name if current_user %></span>
        <%= link_to "Sair", destroy_user_session_path, data: { "turbo-method": :delete }, style: "color:#fff;text-decoration:underline;font-size:13px;" %>
      </div>
    </div>

    <span class="ls-show-sidebar ls-ico-menu"></span>
    <h1 class="ls-brand-name"><%= link_to SECRETS["site"]["name"], root_path, title: SECRETS["site"]["name"], class: "ls-ico-accessibility" %></h1>
  </div>
  <main class="ls-main ">

    <div class="container-fluid">
      <%= yield %>
      
      
      <footer class="ls-footer" role="contentinfo">
        <div class="ls-footer-info">
          <p class="ls-copy-right">Copyright © 2026 - Website desenvolvido por Mconsulting</p>
        </div>
      </footer>
    </div>

  </main>

  <%= render 'shared/menu' %>

  <script type='text/javascript'>
    <%= yield :javascript %>

    // =====================================================================
    // GERENCIADOR DE ABAS — delegação de eventos no document.
    // Um único listener permanente, nunca perdido por re-renders do Turbo.
    // =====================================================================
    document.addEventListener('click', function(e) {
      var link = e.target.closest('.ls-tabs-nav a[href^="#"]');
      if (!link) return;

      e.preventDefault();
      var targetId = link.getAttribute('href').replace('#', '');
      var nav = link.closest('.ls-tabs-nav');
      var container = nav.closest('fieldset') || nav.parentNode;

      // Desativa todas as abas nav
      nav.querySelectorAll('a').forEach(function(a) {
        a.parentElement.classList.remove('ls-active');
      });
      // Ativa a aba clicada
      link.parentElement.classList.add('ls-active');

      // Esconde todos os painéis de conteúdo
      container.querySelectorAll('.ls-tab-content').forEach(function(panel) {
        panel.classList.remove('ls-active');
      });
      // Exibe o painel correspondente
      var target = document.getElementById(targetId);
      if (target) { target.classList.add('ls-active'); }
    });

    // =====================================================================
    // Toggle robusto do menu lateral (sidebar) responsivo
    // =====================================================================
    document.addEventListener('click', function(e) {
      var toggleBtn = e.target.closest('.ls-show-sidebar');
      if (toggleBtn) {
        e.preventDefault();
        e.stopPropagation();
        document.documentElement.classList.toggle('ls-sidebar-visible');
        return;
      }
      var sidebar = e.target.closest('.ls-sidebar');
      var topbar = e.target.closest('.ls-topbar');
      if (!sidebar && !topbar && document.documentElement.classList.contains('ls-sidebar-visible')) {
        document.documentElement.classList.remove('ls-sidebar-visible');
      }
    });

    // =====================================================================
    // COLLAPSE / EXPAND — compatível com data-ls-module="collapse" do Locastyle.
    // O módulo nativo do Locastyle não reinicializa após navegação Turbo
    // (depende de window.load que não dispara novamente). Este handler substitui.
    // =====================================================================
    document.addEventListener('click', function(e) {
      var header = e.target.closest('[data-ls-module="collapse"] .ls-collapse-header');
      if (!header) return;

      e.preventDefault();
      e.stopPropagation();

      var container = header.closest('[data-ls-module="collapse"]');
      var targetId  = container.getAttribute('data-target');
      var body      = document.querySelector(targetId);
      if (!body) return;

      var isOpen = container.classList.contains('ls-collapse-opened');

      if (isOpen) {
        // Fechar com animação slideUp
        body.style.overflow   = 'hidden';
        body.style.maxHeight  = body.scrollHeight + 'px';
        body.offsetHeight;    // força reflow
        body.style.transition = 'max-height 0.25s ease-out';
        body.style.maxHeight  = '0';
        setTimeout(function() {
          body.style.display   = 'none';
          body.style.maxHeight = '';
          body.style.transition = '';
          body.style.overflow  = '';
        }, 260);
        container.classList.remove('ls-collapse-opened');
        header.setAttribute('aria-expanded', 'false');
        body.setAttribute('aria-hidden', 'true');
      } else {
        // Abrir com animação slideDown
        body.style.display    = '';
        body.style.overflow   = 'hidden';
        body.style.maxHeight  = '0';
        body.offsetHeight;    // força reflow
        body.style.transition = 'max-height 0.25s ease-in';
        body.style.maxHeight  = body.scrollHeight + 'px';
        setTimeout(function() {
          body.style.maxHeight  = '';
          body.style.transition = '';
          body.style.overflow   = '';
        }, 260);
        container.classList.add('ls-collapse-opened');
        header.setAttribute('aria-expanded', 'true');
        body.setAttribute('aria-hidden', 'false');
      }
    });

    // Impede que clicks dentro do corpo do collapse fechem o painel acidentalmente
    document.addEventListener('click', function(e) {
      if (e.target.closest('[data-ls-module="collapse"] .ls-collapse-body')) {
        e.stopPropagation();
      }
    });

    // Inicializa o estado dos collapses: esconde todos os fechados ao carregar a página
    function initCollapses() {
      document.querySelectorAll('[data-ls-module="collapse"]').forEach(function(container) {
        var targetId = container.getAttribute('data-target');
        var body     = document.querySelector(targetId);
        if (!body) return;
        if (!container.classList.contains('ls-collapse-opened') &&
            !container.classList.contains('ls-collapse-opened-always')) {
          body.style.display = 'none';
        }
      });
    }

    // Roda no carregamento inicial e em cada navegação Turbo
    document.addEventListener('DOMContentLoaded', initCollapses);
    document.addEventListener('turbo:load', initCollapses);

  </script>

</body>
</html>
