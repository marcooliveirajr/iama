<%= form_for(@health_terminology, html: { class: "ls-form row" }) do |f| %>

  <fieldset>

    <div class="row">
      <div class="col-md-8">
        <label class="ls-label col-md-8 <%= class_error @health_terminology, :code_tuss %>">
        <span class="ls-label-text"><%= f.label :code_tuss, "Código TUSS" %></span>
        <%= f.number_field :code_tuss %>
        <%= show_message_error @health_terminology, :code_tuss %>
      </label>
     </div>
    </div>

    <div class="row">
      <div class="col-md-8">
        <label class="ls-label col-md-8">
        <span class="ls-label-text"><%= f.label :description_tuss, "Procedimento" %></span>
        <%= f.text_field :description_tuss %>
      </label>
     </div>
    </div>

    <div class="row">
      <div class="col-md-8">
        <label class="ls-label col-md-8">
        <span class="ls-label-text"><%= f.label :measure, "Porte" %></span>
        <%= f.number_field :measure %>
      </label>
     </div>
    </div>

    <div class="row">
      <div class="col-md-8">
        <label class="ls-label col-md-8 <%= class_error @health_terminology, :version_id %>">
        <span class="ls-label-text"><%= f.label :version_id, "Versão da Tabela" %></span>
          <div class="ls-custom-select">
            <%= f.collection_select(:version_id, Version.all, :id, :name, class: "ls-state ls-select", prompt: true) %>
          </div>
          <%= show_message_error @health_terminology, :version_id %>
        </label>
      </div>
    </div>


 </fieldset>

  <div class="ls-actions-btn">
      <%= f.button  "Salvar", :type => "submit" , class: "ls-btn-primary"%>
      <%= link_to 'Voltar', health_terminologies_path, class: "ls-btn-darker" %>
  </div>

<% end %>

