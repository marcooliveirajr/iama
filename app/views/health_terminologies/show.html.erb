<h1 class="ls-title-intro ls-ico-text">Procedimento</h1>
<%= flash_messages %>
<div class="ls-box">
  <div class="row">
    <div class="col-md-12">
        <table class="ls-table ls-table-striped ls-no-hover ls-sm-space ls-no-margin-top">
          <tbody>
            <tr> <td> Código TUSS: <label class="ls-title-6"><%= @health_terminology.code_tuss %></label> </td> </tr>
            <tr> <td> Procedimento: <label class="ls-title-6"><%= @health_terminology.description_tuss %></label> </td> </tr>
            <tr> <td> Categoria: <label class="ls-title-6"><%= @health_terminology.category_tuss %></label> </td> </tr>
            <tr> <td> Porte: <label class="ls-title-6"><%= @health_terminology.size %></label> </td> </tr>
            <tr> <td> Versão: <label class="ls-title-6"><%= @health_terminology.version %></label> </td> </tr>
          </tbody>
        </table>
    </div>
  </div>
</div>

<%= link_to 'Editar', edit_health_terminology_path(@health_terminology) , class: "ls-btn-darker" %>
<%= link_to 'Voltar', health_terminologies_path, class: "ls-btn-darker" %>
