<h1 class="ls-title-intro ls-ico-text">TUSS</h1>

<a><%= link_to 'Cadastrar Procedimento', new_health_terminology_path(@health_terminologies) , class: "ls-btn-primary" %></a>

<div class="ls-box-filter">
  <form method="get" accept-charset="UTF-8" action="/hospitals/search" id="new_customer_search" class="ls-form ls-form-inline" novalidate="novalidate"><input type="hidden" value="✓" name="utf8">
    <label class="ls-label col-md-4">
      <b class="ls-label-text">Buscar por:</b>
      <div class="ls-custom-select">
        <select name="" class="ls-select">
          <option>Código TUSS</option>
          <option>Procedimento</option>
        </select>
      </div>
    </label>

    <label role="search" class="ls-label col-md-4">
      <div>
        <input type="text" class="ls-field">
      </div>
    </label>
    <label class="ls-label ">
      <input type="submit" class="ls-btn" value="Buscar" name="commit" aria-expanded="false" role="combobox">
    </label>
  </form>
</div>

<table class="ls-table ls-table-striped">
  <thead>
    <tr>
      <th>Código TUSS</th>
      <th class="hidden-xs">Procedimento</th>
      <th class="hidden-xs">Categoria</th>
      <th class="hidden-xs">CH Cirugião</th>
      <th class="hidden-xs">Porte</th>
      <th class="hidden-xs">Número Auxiliar</th>
    </tr>
  </thead>

  <tbody>
    <% @health_terminologies.each do |health_terminology| %>
    <tr>
      <td><%= link_to health_terminology.code_tuss, health_terminology %></td>
      <td class="hidden-xs"><%= health_terminology.description_tuss %></td>
      <td class="hidden-xs"><%= health_terminology.category_tuss %></td>
      <td class="hidden-xs"><%= health_terminology.ch_surgeon %></td>
      <td class="hidden-xs"><%= health_terminology.size %></td>
      <td class="hidden-xs"><%= health_terminology.number_aux %></td>
    </tr>
    <% end %>
  </tbody>
</table>

<% if @health_terminologies %>
<div class="ls-pagination-filter">
  <%= paginate @health_terminologies if @health_terminologies %>

  <% if not @health_terminologies.blank? %>
  <div class="ls-filter-view">
    <%= t 'helpers.show' %>
    <div class="ls-custom-select">
      <%= select_tag(:per_page_options, options_for_select(options_for_per_page, params[:per_page]))%>
    </div>
    <%= t 'helpers.per_page' %>
  </div>
  <% end %>
</div>
<% end %>