<%= form_for(@bedroom, html: { class: "ls-form row" }) do |f| %>
  <% if @bedroom.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(@bedroom.errors.count, "error") %> prohibited this bedroom from being saved:</h2>

      <ul>
      <% @bedroom.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>
  
  <fieldset>

    <div class="row">
      <div class="col-md-8">
        <label class="ls-label col-md-8">
        <span class="ls-label-text"><%= f.label :name, "Nome" %></span>
        <%= f.text_field :name %>
      </label>
     </div>
    </div>

    <div class="row">
      <div class="col-md-8">
        <label class="ls-label col-md-4">
        <span class="ls-label-text"><%= f.label :hospital_id, "Hospital" %></span>
          <div class="ls-custom-select">
            <%= f.collection_select(:hospital_id, Hospital.all, :id, :name, class: "ls-state ls-select") %>
          </div>
        </label>
      </div>
    </div>

 </fieldset>

  <div class="ls-actions-btn">
      <%= f.button  "Salvar", :type => "submit" , class: "ls-btn-primary"%>
      <%= f.submit "Limpar", :type => "reset",  class: "ls-btn-primary" %>
      <%= link_to 'Voltar', bedrooms_path, class: "ls-btn-darker" %>
  </div>

<% end %>

