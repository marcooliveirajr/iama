<h1 class="ls-title-intro ls-ico-text">Versões</h1>
<%= flash_messages %>
<a><%= link_to 'Cadastrar Versão', new_version_path(@version) , class: "ls-btn-primary" %></a>
<br></br>


<tbody>
  <% @versions.each do |version| %>

  <div class="ls-list">
    <header class="ls-list-header">
      <div class="ls-list-title col-md-9">
        <strong><%= link_to version.name, version %></strong>
      </div>
      <div class="col-md-3 ls-txt-right">
        <div data-ls-module="dropdown" class="ls-dropdown ls-pos-right">
          <a href="#" class="ls-btn-primary">Administrar</a>
          <ul class="ls-dropdown-nav">
            <li><%= link_to 'Editar', edit_version_path(version) %></li>
            <li><%= link_to 'Visualizar', version %></li>
            <li><%= link_to 'Excluir', version_path(version), data: { confirm: "Você tem certeza?" }, method: :delete, class: "ls-color-danger ls-divider" %></li>
          </ul>
        </div>
      </div>
    </header>
  </div>

  <% end %>
</tbody>

