<h1 class="ls-title-intro ls-ico-text">Hospitais</h1>

<a><%= link_to 'Cadastrar Hospital', new_hospital_path(@hospital) , class: "ls-btn-primary" %></a>

<div class="ls-box-filter">
  <form method="get" accept-charset="UTF-8" action="/hospitals/search" id="new_customer_search" class="ls-form ls-form-inline" novalidate="novalidate"><input type="hidden" value="✓" name="utf8">
    <label class="ls-label col-md-4">
      <b class="ls-label-text">Buscar por:</b>
      <div class="ls-custom-select">
        <select name="" class="ls-select">
          <option>Nome</option>
          <option>Tipo</option>
          <option>Status</option>
        </select>
      </div>
    </label>

    <label role="search" class="ls-label col-md-4">
      <div>
        <input type="text" class="ls-field">
      </div>
    </label>
    <label class="ls-label ">
      <input type="submit" class="ls-btn" value="Buscar" name="commit" aria-expanded="false" role="combobox">
    </label>
  </form>
</div>

<tbody>
  <% @hospitals.each do |hospital| %>

  <div class="ls-list">
    <header class="ls-list-header">
      <div class="ls-list-title col-md-9">
        <strong><%= link_to hospital.name, hospital %></strong>
      </div>
      <div class="col-md-3 ls-txt-right">
        <div data-ls-module="dropdown" class="ls-dropdown ls-pos-right">
          <a href="#" class="ls-btn-primary">Administrar</a>
          <ul class="ls-dropdown-nav">
            <li><%= link_to 'Editar', edit_hospital_path(hospital) %></li>
            <li><%= link_to 'Visualizar', hospital %></li>
            <li><%= link_to 'Excluir', hospital_path(hospital), data: { confirm: "Você tem certeza?" }, method: :delete, class: "ls-color-danger ls-divider" %></li>
          </ul>
        </div>
      </div>
    </header>
    <div class="ls-list-content ">
      <div class="col-xs-12 col-md-6">
        <span class="ls-list-label">Tipo</span>
        <strong><%= hospital.kind %></strong>
      </div>
      <div class="col-xs-12 col-md-6">
        <span class="ls-list-label">Status</span>
        <strong><%= hospital.status %></strong>
      </div>
    </div>
  </div>

  <% end %>
</tbody>
</table>

<div class="ls-pagination-filter">
  <ul class="ls-pagination">
    <li class="ls-disabled"><a href="#">&laquo; Anterior</a></li>
    <li class="ls-active"><a href="#">1</a></li>
    <li><a href="#">2</a></li>
    <li><a href="#">3</a></li>
    <li><a href="#">4</a></li>
    <li><a href="#">5</a></li>
    <li><a href="#">Próximo &raquo;</a></li>
  </ul>

  <div class="ls-filter-view">
    Exibir
    <div class="ls-custom-select">
      <select name="" id="" class="ls-select">
        <option value="10">10</option>
        <option value="30">30</option>
        <option value="50">50</option>
        <option value="100">100</option>
      </select>
    </div>
    ítens por página
  </div>
</div>
