<h1 class="ls-title-intro ls-ico-cog">Hospitais</h1>

<div class="container-fluid">
  <%= link_to 'Cadastrar Hospital', new_hospital_path(@hospital) , class: "ls-btn-primary" %>
</div>

<div class="ls-box-filter">
  <form action="" class="ls-form ls-form-inline ls-float-left">
    <label class="ls-label col-md-8 col-sm-8">
      <b class="ls-label-text">Buscar por</b>
      <div class="ls-custom-select">
        <select name="" class="ls-select">
          <option>Nome</option>
          <option>Tipo</option>
          <option>Status</option>
        </select>
      </div>
    </label>
  </form>

  <form  action="" class="ls-form ls-form-inline ls-float-right">
    <label class="ls-label" role="search">
      <b class="ls-label-text ls-hidden-accessible">Nome do cliente</b>
      <input type="text" id="q" name="q" required="" class="ls-field">
    </label>
    <div class="ls-actions-btn">
      <input type="submit" value="Buscar" class="ls-btn" title="Buscar">
    </div>
  </form>
</div>



<table class="ls-table ls-table-striped">
  <thead>
    <tr>
      <th>Nome</th>
      <th class="hidden-xs">Tipo</th>
      <th>Status</th>
    </tr>
  </thead>

  <tbody>
    <% @hospitals.each do |hospital| %>
    <tr>
      <td><%= link_to hospital.name, hospital %></td>
      <td class="hidden-xs"><%= hospital.kind %></td>
      <td><%= hospital.status %></td>
    </tr>
    <% end %>
  </tbody>
</table>


<% @hospitals.each do |hospital| %>

<div class="ls-list">
  <header class="ls-list-header">
    <div class="ls-list-title col-md-9">
      <strong>Nome</strong>
      <small><%= link_to hospital.name, hospital %></small>
    </div>
  </header>
  <div class="ls-list-content ">
    <div class="col-xs-12 col-md-6">
        <span class="ls-list-label">Tipo</span>
      <strong><%= hospital.kind %></strong>
    </div>
    <div class="col-xs-12 col-md-6">
      <span class="ls-list-label">Status</span>
      <strong><%= hospital.status %></strong>
    </div>

  </div>
</div>
<% end %>

