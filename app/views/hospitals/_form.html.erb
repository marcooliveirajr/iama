<%= form_for(@hospital, html: { class: "ls-form row" }) do |f| %>

  <fieldset>

    <div class="row">
      <div class="col-md-8">
        <label class="ls-label col-md-8 <%= class_error @hospital, :name %>">
        <span class="ls-label-text"><%= f.label :name, "Nome" %></span>
        <%= f.text_field :name %>
        <%= show_message_error @hospital, :name %>
      </label>
     </div>
    </div>

 </fieldset>

<div class="ls-actions-btn">
    <%= f.button  "Salvar", :type => "submit" , class: "ls-btn-primary"%>
    <%= link_to 'Voltar', hospitals_path, class: "ls-btn-darker" %>
</div>

<% end %>
