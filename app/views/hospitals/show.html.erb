<h1 class="ls-title-intro ls-ico-text">Hospitais</h1>

<div class="ls-box">
  <div class="row">
    <div class="col-md-12">
        <table class="ls-table ls-table-striped ls-no-hover ls-sm-space ls-no-margin-top">
          <tbody>
            <tr> <td> Nome: <label class="ls-title-6"><%= @hospital.name %></label> </td> </tr>
            <tr> <td> Tipo: <label class="ls-title-6"><%= @hospital.kind %></label> </td> </tr>
            <tr> <td> Status: <label class="ls-title-6"><%= @hospital.status %></label> </td> </tr>
          </tbody>
        </table>
    </div>
  </div>
</div>

<%= link_to 'Editar', edit_hospital_path(@hospital) , class: "ls-btn-darker" %>
<%= link_to 'Voltar', hospitals_path, class: "ls-btn-darker" %>
