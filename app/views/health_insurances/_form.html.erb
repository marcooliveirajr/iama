<%= form_for(@health_insurance, html: { class: "ls-form row" }) do |f| %>

  <fieldset>

    <div class="row">
      <div class="col-md-8">
        <label class="ls-label col-md-6">
        <span class="ls-label-text"><%= f.label :name, "Nome" %></span>
        <%= f.text_field :name %>
      </label>
     </div>
    </div>

    <div class="row">
      <div class="col-md-8">
        <label class="ls-label col-md-6">
        <span class="ls-label-text"><%= f.label :type, "Tipo" %></span>
        <%= f.text_field :type %>
      </label>
     </div>
    </div>

    <div class="row">
      <div class="col-md-8">
        <label class="ls-label col-md-5">
        <span class="ls-label-text"><%= f.label :status, "Status" %></span>
        <%= f.text_field :status %>
      </label>

         <%= f.button  "Salvar", :type => "submit" , class: "ls-btn-primary"%>
         <%= f.submit "Limpar", :type => "reset",  class: "ls-btn-primary" %>
         <%= link_to 'Voltar', health_insurances_path, class: "ls-btn-darker" %>
    </div>
    </div>

 </fieldset>

<% end %>
