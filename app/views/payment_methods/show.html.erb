<h1 class="ls-title-intro ls-ico-text">Método de Pagamento</h1>
<%= flash_messages %>
<div class="ls-box">
  <div class="row">
    <div class="col-md-12">
        <table class="ls-table ls-table-striped ls-no-hover ls-sm-space ls-no-margin-top">
          <tbody>
            <tr> 
            	<td> Nome: 
            		<label class="ls-title-6"><%= @payment_method.name %>
            		</label> 
            	</td>
            </tr>
          </tbody>
        </table>
    </div>
  </div>
</div>

<%= link_to 'Editar', edit_payment_method_path(@payment_method) , class: "ls-btn-darker" %>
<%= link_to 'Voltar', payment_methods_path, class: "ls-btn-darker" %>
<a><%= link_to 'Cadastrar Método de Pagamento', new_payment_method_path(@payment_method) , class: "ls-btn-primary" %></a>