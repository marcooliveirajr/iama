<h1 class="ls-title-intro ls-ico-user">Cirurgiões</h1>

<div class="ls-box">
  <div class="row">
    <div class="col-md-12">
        <table class="ls-table ls-table-striped ls-no-hover ls-sm-space ls-no-margin-top">
          <tbody>
            <tr> <td> Nome: <label class="ls-title-6"><%= @surgeon.name %></label> </td> </tr>
            <tr> <td> CPF: <label class="ls-title-6"><%= @surgeon.cpf %></label> </td> </tr>
            <tr> <td> Telefone: <label class="ls-title-6"><%= @surgeon.phone %></label> </td> </tr>
            <tr> <td> Email: <label class="ls-title-6"><%= @surgeon.email %></label> </td> </tr>
            <tr> <td> CEP: <label class="ls-title-6"><%= @surgeon.postal_code %></label> </td> </tr>
            <tr> <td> Endereço: <label class="ls-title-6"><%= @surgeon.address %></label> </td> </tr>
            <tr> <td> Número: <label class="ls-title-6"><%= @surgeon.address_number %></label> </td> </tr>
            <tr> <td> Complemento: <label class="ls-title-6"><%= @surgeon.address_complement %></label> </td> </tr>
            <tr> <td> Bairro: <label class="ls-title-6"><%= @surgeon.district %></label> </td> </tr>
            <tr> <td> Cidade: <label class="ls-title-6"><%= @surgeon.city %></label> </td> </tr>
            <tr> <td> Estado: <label class="ls-title-6"><%= @surgeon.state %></label> </td> </tr>
          </tbody>
        </table>
    </div>
  </div>
</div>

<%= link_to 'Editar', edit_surgeon_path(@surgeon) , class: "ls-btn-darker" %>
<%= link_to 'Voltar', surgeons_path, class: "ls-btn-darker" %>
