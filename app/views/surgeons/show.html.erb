<h1 class="ls-title-intro ls-ico-cog">Cirurgiões</h1>
<%= form_for(@surgeon, html: { class: "ls-form row" }) do |f| %>
<div class="ls-box">
<div class="row">
  <div class="col-md-12">
    <div class="ls-box">
      <p><strong>Nome</strong></p>
      <p class="ls-break-text"><%= @surgeon.name %></p>
      <hr>
      <p><strong>CPF</strong></p>
      <p class="ls-break-text"><%= @surgeon.cpf %></p>
      <hr>
      <p><strong>Telefone</strong></p>
      <p class="ls-break-text"><%= @surgeon.phone %></p>
      <hr>
      <p><strong>Email</strong></p>
      <p class="ls-break-text"><%= @surgeon.email %></p>
      <hr>
      <p><strong>CEP</strong></p>
      <p class="ls-break-text"><%= @surgeon.postal_code %></p>
      <hr>
      <p><strong>Endereço</strong></p>
      <p class="ls-break-text"><%= @surgeon.address %></p>
      <hr>
      <p><strong>Número</strong></p>
      <p class="ls-break-text"><%= @surgeon.address_number %></p>
      <hr>
      <p><strong>Complemento</strong></p>
      <p class="ls-break-text"><%= @surgeon.address_complement %></p>
      <hr>
      <p><strong>Bairro</strong></p>
      <p class="ls-break-text"><%= @surgeon.district %></p>
      <hr>
      <p><strong>Cidade</strong></p>
      <p class="ls-break-text"><%= @surgeon.city %></p>
      <hr>
      <p><strong>Estado</strong></p>
      <p class="ls-break-text"><%= @surgeon.state %></p>

    </div>
  </div>
</div>
</div>

<%= link_to 'Editar', edit_surgeon_path(@surgeon) , class: "ls-btn-darker" %>
<%= link_to 'Voltar', surgeons_path, class: "ls-btn-darker" %>

<% end %>
